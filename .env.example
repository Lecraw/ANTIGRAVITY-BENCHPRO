# BenchPro — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ===== Required for AI features =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== Required for production =====
SECRET_KEY=generate_a_long_random_string_here
FLASK_DEBUG=false

# ===== Server =====
HOST=0.0.0.0
PORT=5050

# ===== CORS (comma-separated origins, or * for all) =====
# Production example: https://benchpro.app,https://www.benchpro.app
CORS_ORIGINS=*

# ===== Rate limiting =====
# Format: "N per minute" or "N per hour"
RATE_LIMIT=200 per minute
RATE_LIMIT_AUTH=10 per minute
RATE_LIMIT_UPLOAD=20 per hour

# ===== Email (for password reset & confirmation) =====
# Set EMAIL_ENABLED=true to send real emails. When false, links are logged to console.
APP_URL=http://localhost:5050
MAIL_FROM=noreply@benchpro.app
EMAIL_ENABLED=false

# SMTP (when EMAIL_ENABLED=true)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your_app_password

# Or use Resend (set RESEND_API_KEY to use instead of SMTP)
# RESEND_API_KEY=re_xxxxx

# ===== Stripe (subscriptions) =====
# Create products/prices in Stripe Dashboard, then add price IDs here.
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# STRIPE_PRICE_STANDARD=price_xxxxx
# STRIPE_PRICE_ELITE=price_xxxxx
# STRIPE_TRIAL_DAYS=14

# ===== OAuth (Google, Apple) =====
# Leave empty to hide social login buttons. APP_URL must match your app URL for redirect_uri.
# Google: Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx
# Apple: Requires Apple Developer account. Create Sign in with Apple, Services ID, and key.
# APPLE_CLIENT_ID=org.benchpro.app (Services ID)
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ===== Optional overrides =====
# TEAM_CODE=YOURCODE
# TEAM_NAME=Your Team Name
